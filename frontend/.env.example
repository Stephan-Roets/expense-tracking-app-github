# API URL for backend
# For production: set to your deployed backend URL (e.g., https://your-api.example.com/api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# WorldVectorLogo API Key (optional - enables 500 requests/day instead of 10)
# Get your API key from: https://worldvectorlogo.com/account/api-keys
# Leave empty to use anonymous access (10 requests/day per IP)
NEXT_PUBLIC_WORLD_VECTOR_LOGO_API_KEY=
